    "pixi.js": "^8.23.0",
    "vue": "^3.5.0",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  }
